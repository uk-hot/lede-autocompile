# ==========================================
# 京东云一代 RE-SP-01B 软件包配置
# 针对 32MB Flash 优化，精简插件
# ==========================================

# ---- LuCI Base ----
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-compat=y

# ---- 核心应用 (必选) ----
CONFIG_PACKAGE_luci-app-firewall=y
# CONFIG_PACKAGE_luci-app-turboacc is not set

# ---- 网络工具 ----
CONFIG_PACKAGE_luci-app-upnp=y
# CONFIG_PACKAGE_luci-app-ddns is not set
# CONFIG_PACKAGE_luci-app-wol is not set
# CONFIG_PACKAGE_luci-app-tailscale is not set

# ---- 存储管理 (eMMC 挂载) ----
# CONFIG_PACKAGE_luci-app-hd-idle is not set
# CONFIG_PACKAGE_luci-app-samba4 is not set
# 注意: Samba4 约 3-4MB，32MB Flash 空间不足，如需可后期通过 eMMC 安装

# ---- 系统工具 ----
# CONFIG_PACKAGE_luci-app-ttyd is not set
CONFIG_PACKAGE_luci-app-autoreboot=y
# CONFIG_PACKAGE_luci-app-rtp2httpd is not set

# ---- 科学上网 (Passwall + Xray + Hysteria2) ----
CONFIG_PACKAGE_luci-app-passwall=y
# 透明代理走 iptables (触发 select 链拉入 iptables-mod-socket/iprange/tproxy/conntrack-extra)
CONFIG_PACKAGE_luci-app-passwall_Iptables_Transparent_Proxy=y
# CONFIG_PACKAGE_luci-app-passwall_Nftables_Transparent_Proxy is not set
# 主内核: Xray (VLESS/REALITY/Trojan/SS)
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Xray=y
CONFIG_PACKAGE_xray-core=y
# 副内核: Hysteria2 (UDP-based, 抗丢包)
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Hysteria=y
CONFIG_PACKAGE_hysteria=y
# 不打包 SingBox / SSR-Plus / OpenClash (节省 Flash)
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_SingBox is not set
# CONFIG_PACKAGE_sing-box is not set
# CONFIG_PACKAGE_luci-app-ssr-plus is not set
# CONFIG_PACKAGE_luci-app-openclash is not set

# ---- 禁用的大型应用 (节省空间) ----
# CONFIG_PACKAGE_luci-app-accesscontrol is not set
# CONFIG_PACKAGE_luci-app-adbyby-plus is not set
# CONFIG_PACKAGE_luci-app-alist is not set
# CONFIG_PACKAGE_luci-app-dockerman is not set
# CONFIG_PACKAGE_luci-app-frpc is not set
# CONFIG_PACKAGE_luci-app-ipsec-vpnd is not set
# CONFIG_PACKAGE_luci-app-mosdns is not set
# CONFIG_PACKAGE_luci-app-nlbwmon is not set
# CONFIG_PACKAGE_luci-app-smartdns is not set
# CONFIG_PACKAGE_luci-app-store is not set
# CONFIG_PACKAGE_luci-app-vlmcsd is not set
# CONFIG_PACKAGE_luci-app-vsftpd is not set
# CONFIG_PACKAGE_luci-app-wireguard is not set
# CONFIG_PACKAGE_luci-app-zerotier is not set

# ---- 基础软件 ----
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_wget-ssl=y
